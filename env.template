# ============================================
# BREVO (Email & Newsletter) Configuration
# ============================================
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Your Brevo newsletter list ID
# Find this in Brevo dashboard: Lists > Your List > Settings
BREVO_LIST_ID=2

# Sender email (must be verified in Brevo)
# Go to Brevo dashboard: Senders & IP > Senders > Add sender
BREVO_FROM_EMAIL=info@jonspirit.com

# Sender name (displayed in emails)
BREVO_FROM_NAME=Jon Spirit

# ============================================
# Contact Form Configuration
# ============================================
# Email address where contact form submissions will be sent
CONTACT_EMAIL=info@yourdomain.com

# ============================================
# Admin Panel Configuration
# ============================================
# Password for admin panel access at /spirit-admin-x7k9
ADMIN_PASSWORD=your_secure_admin_password_here

# ============================================
# Spotify Integration (Optional)
# ============================================
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ============================================
# Cron Jobs / Scheduled Tasks
# ============================================
# Secret token for cron job authentication
# Used for scheduled newsletter processing
CRON_SECRET=your_random_cron_secret_here

# ============================================
# Site Configuration
# ============================================
# Your site URL (used for generating tracking links, etc.)
NEXT_PUBLIC_SITE_URL=https://jonspirit.com

# ============================================
# Database (Vercel Postgres)
# ============================================
# If using Vercel Postgres, these are automatically provided by Vercel
# For local development, you may need:
# POSTGRES_URL=postgresql://user:password@host:port/database
# POSTGRES_PRISMA_URL=postgresql://user:password@host:port/database?schema=public
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host:port/database

# ============================================
# Environment
# ============================================
# Set to "production" for production, "development" for local dev
NODE_ENV=development
